# Discord Bot Token
DISCORD_TOKEN=your_bot_token_here

# Application ID (Client ID)
CLIENT_ID=your_application_id_here

# Bot owner Discord user IDs (comma separated)
OWNER_IDS=123456789,987654321

# Optional: Lock commands to specific channel
LOCKED_CHANNEL_ID=

# Join settings
JOIN_DELAY_MS=800
MAX_CONCURRENT_JOINS=5

# Bot appearance
BOT_STATUS=Emorce Tokens
BOT_ACTIVITY=Watching

# Data storage (use /data for Railway volume)
DATA_DIR=./data

# Optional: Guild ID for faster command registration
GUILD_ID=
