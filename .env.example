# === REQUIRED ===
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id
GUILD_ID=your_main_server_id_optional

# === OWNER / LOCK ===
OWNER_IDS=123456789012345678,987654321098765432
LOCKED_CHANNEL_ID=

# === TOKEN STORAGE ===
# tokens.txt will be created / loaded from ./data/tokens.txt
# On Railway use a volume mounted at /data if you want persistence

# === JOINER SETTINGS ===
JOIN_DELAY_MS=800
MAX_CONCURRENT_JOINS=5
MAX_TOKENS=50000

# === OPTIONAL ===
BOT_STATUS=watching Emorce Tokens
BOT_ACTIVITY=Emorce Token Live